# ============================================
# Django Settings
# ============================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# ============================================
# Database (PostgreSQL)
# ============================================
DB_NAME=carmarket_db
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# ============================================
# Payment (Zarinpal)
# ============================================

# برای تست (Sandbox)
ZARINPAL_MERCHANT_CODE=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=True

# برای production (بعداً)
# ZARINPAL_MERCHANT_CODE=your-real-merchant-code
# ZARINPAL_SANDBOX=False

# ============================================
# Site
# ============================================
SITE_URL=http://127.0.0.1:8000